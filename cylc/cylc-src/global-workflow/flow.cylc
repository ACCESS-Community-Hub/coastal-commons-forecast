#!jinja2
## https://cylc.github.io/cylc-doc/stable/html/user-guide/writing-workflows/jinja2.html#jinja

[scheduler]
    UTC mode = True

[scheduling]
    initial cycle point = previous(T00Z)
    runahead limit = P0D ## maximum of cycle points to be active at the same time
    
    [[xtriggers]]
        T0_plus_8h = wall_clock(offset=PT8H)

    [[graph]]
        ## -- 00Z daily
        T00 = """
            @wall_clock => down_gdac-argo_aus
            @T0_plus_8h => down_ecmwf-ifs_global => subset_ecmwf-ifs_global-to-aus
            @T0_plus_8h => down_cmems-mercator_aus
        """

[runtime]

    [[root]]
        env-script = "source $HOME/.my_cylc.env"

    [[down_ecmwf-ifs_global]]
        platform = gadi_pbs
        script = $MY_TASK_SCRIPT_DIR/jobscript_gadi-python-hydra.sh
        execution retry delays = 1*PT5M 
        submission retry delays = 1*PT5M
        [[[environment]]]
            TASK_SCRIPT_FILE = $MY_TASK_SCRIPT_DIR/ecmwf-ifs/download_atmos_ecmwf.py
            TASK_CONFIG_DIR = $CYLC_WORKFLOW_SOURCE_DIR/global-workflow/task-config
            TASK_CONFIG_FILE = download_atmos_ecmwf-ifs_global
            HYDRA_FULL_ERROR = 1
        [[[directives]]]
            -q = copyq
            -l ncpus=1
            -l mem=3GB
            -l walltime=01:00:00

    [[subset_ecmwf-ifs_global-to-aus]]
        platform = gadi_pbs
        script = $MY_TASK_SCRIPT_DIR/jobscript_gadi-python-hydra.sh
        execution retry delays = 1*PT5M
        submission retry delays = 1*PT5M
        [[[environment]]]
            TASK_SCRIPT_FILE = $MY_TASK_SCRIPT_DIR/ecmwf-ifs/subset_atmos_ecmwf-ifs_global.py
            TASK_CONFIG_DIR = $CYLC_WORKFLOW_SOURCE_DIR/global-workflow/task-config
            TASK_CONFIG_FILE = subset_atmos_ecmwf-ifs_global-to-aus
            HYDRA_FULL_ERROR = 1
        [[[directives]]]
            -q = normal
            -l ncpus=1
            -l mem=5GB
            -l walltime=00:10:00

    [[down_cmems-mercator_aus]]
        platform = gadi_pbs
        script = $MY_TASK_SCRIPT_DIR/jobscript_gadi-python-hydra.sh
        execution retry delays = 1*PT5M 
        submission retry delays = 1*PT5M
        [[[environment]]]
            TASK_SCRIPT_FILE = $MY_TASK_SCRIPT_DIR/cmems-mercator/download_ocean_cmems-mercator.py
            TASK_CONFIG_DIR = $CYLC_WORKFLOW_SOURCE_DIR/global-workflow/task-config
            TASK_CONFIG_FILE = download_ocean_cmems-mercator_aus
            HYDRA_FULL_ERROR = 1
        [[[directives]]]
            -q = copyq
            -l ncpus=1
            -l mem=5GB
            -l walltime=04:00:00

    [[down_gdac-argo_aus]]
        platform = gadi_pbs
        script = $MY_TASK_SCRIPT_DIR/jobscript_gadi-python-hydra.sh
        execution retry delays = 1*PT30M 
        submission retry delays = 1*PT5M
        [[[environment]]]
            TASK_SCRIPT_FILE = $MY_TASK_SCRIPT_DIR/gdac-argo/download_ocean_gdac-argo.py
            TASK_CONFIG_DIR = $CYLC_WORKFLOW_SOURCE_DIR/global-workflow/task-config
            TASK_CONFIG_FILE = download_ocean_gdac-argo_aus
            HYDRA_FULL_ERROR = 1
        [[[directives]]]
            -q = copyq
            -l ncpus=1
            -l mem=3GB
            -l walltime=00:20:00